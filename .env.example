# Puerto del servidor Express
PORT=3000

# URL del webhook al que se enviarán los mensajes entrantes (test-ads / kindev meta ads)
WEBHOOK_URL=https://test-ads-one.vercel.app/api/webhook/whatsapp

# Clave secreta compartida para firmar webhooks (HMAC-SHA256)
WEBHOOK_SECRET=tu_secreto_webhook_aqui

# Clave de administración para proteger /qr, /api/session/reset y detalles del panel
ADMIN_KEY=tu_clave_administrador_super_segura

# Clave para cifrar las credenciales de WhatsApp en reposo con AES-256-GCM en Firestore
SESSION_ENCRYPTION_KEY=tu_clave_de_cifrado_de_sesion_aes256

# ID del proyecto en Firebase para persistencia permanente de sesión
FIREBASE_PROJECT_ID=test-addss

# Filtrado estricto: solo procesar mensajes con metadatos de anuncios de Meta (true / false)
ONLY_META_ADS=true

# Modo depuración: en false enmascara y protege la privacidad de mensajes y teléfonos
DEBUG=false

# Ruta de almacenamiento de sesiones
SESSIONS_DIR=./sessions
