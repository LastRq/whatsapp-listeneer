# Puerto del servidor Express
PORT=3000

# URL del webhook al que se despacharán los leads entrantes (Kindev Meta Ads)
KINDEVADS_WEBHOOK_URL=

# Clave secreta compartida para firmar webhooks (HMAC-SHA256)
WEBHOOK_SECRET=tu_secreto_webhook_aqui

# Clave de administración para proteger /qr, /api/session/reset y métricas
ADMIN_KEY=tu_clave_administrador_super_segura

# Clave para cifrar las credenciales de WhatsApp en reposo con AES-256-GCM
SESSION_ENCRYPTION_KEY=tu_clave_de_cifrado_aes256

# ID del proyecto en Firebase para persistencia permanente de sesión en la nube
KINDEVADS_FIREBASE_API_KEY=AIzaSyDuY8r3OQ08dG-JEk_XSs08M2U8e56W5J8
TENANT_ID=kindev

# Filtrado estricto: solo procesar mensajes con metadatos de anuncios de Meta (true / false)
ONLY_META_ADS=true

# Modo depuración: en false protege la privacidad de mensajes y teléfonos en logs
DEBUG=false

# Ruta de almacenamiento de sesiones
SESSIONS_DIR=./sessions
